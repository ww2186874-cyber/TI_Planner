      "resources": [
        {
          "id": "spi-flash",
          "name": "板载 SPI Flash",
          "shortName": "FLASH",
          "kind": "onboard",
          "bus": "SPI1",
          "defaultEnabled": false,
          "detail": "板载 U24 SPI Flash；关闭只释放当前规划占用，板上器件和走线仍然存在。",
          "pins": { "58": "CS#", "59": "MISO", "60": "MOSI", "61": "CLK" },
          "assignments": { "58": "SPI1_CS0", "59": "SPI1_POCI", "60": "SPI1_PICO", "61": "SPI1_SCK" }
        },
        {
          "id": "h8-lcd",
          "name": "H8 LCD/OLED 接口",
          "shortName": "LCD",
          "kind": "optional",
          "bus": "SPI1",
          "defaultEnabled": false,
          "detail": "可选外接 SPI LCD/OLED；关闭表示当前未接屏幕，不自动占用 LCD 专用控制脚。",
          "pins": { "2": "CS", "28": "BL", "60": "SDA", "61": "SCL", "62": "RES", "63": "DC" },
          "assignments": { "2": "SPI1_CS3", "28": "PB26", "60": "SPI1_PICO", "61": "SPI1_SCK", "62": "PB10", "63": "PB11" }
        },
        {
          "id": "ch340-uart",
          "name": "CH340 串口调试/下载",
          "shortName": "CH340",
          "kind": "onboard",
          "defaultEnabled": false,
          "detail": "PA10/PA11 连接板载 CH340E；关闭只释放当前规划占用，USB 转串口器件仍连接在板上。",
          "pins": { "56": "TX", "57": "RX" },
          "assignments": { "56": "UART0_TX", "57": "UART0_RX" }
        },
        {
          "id": "swd-debug",
          "name": "SWD 下载调试接口",
          "shortName": "SWD",
          "kind": "onboard",
          "defaultEnabled": true,
          "recommended": true,
          "detail": "PA19/PA20 连接板载 DIO/CLK 下载调试接口；正常下载和调试建议保持启用，关闭不代表调试焊盘物理断开。",
          "pins": { "12": "DIO", "13": "CLK" },
          "assignments": { "12": "SWDIO", "13": "SWCLK" }
        },
        {
          "id": "bsl-button",
          "name": "BSL 启动按键",
          "shortName": "BSL",
          "kind": "onboard",
          "defaultEnabled": false,
          "detail": "PA18 连接 BSL 按键及 47 kΩ 下拉；仅在需要通过串口 Bootloader 进入 BSL 时启用，关闭不代表按键电路物理断开。",
          "pins": { "11": "BSL" },
          "assignments": { "11": "BSL_invoke" }
        },
        {
          "id": "user-button",
          "name": "板载功能按键",
          "shortName": "KEY",
          "kind": "onboard",
          "defaultEnabled": false,
          "detail": "PB21 连接低有效用户按键，按下时接地。",
          "pins": { "20": "KEY" },
          "assignments": { "20": "PB21" }
        },
        {
          "id": "user-led",
          "name": "板载用户 LED",
          "shortName": "LED",
          "kind": "onboard",
          "defaultEnabled": false,
          "detail": "PB22 经 2 kΩ 电阻和 LED 接地，输出高电平时点亮。",
          "pins": { "21": "LED" },
          "assignments": { "21": "PB22" }
        },
        {
          "id": "nrst-reset",
          "name": "板载复位电路",
          "shortName": "NRST",
          "kind": "onboard",
          "defaultEnabled": true,
          "recommended": true,
          "detail": "NRST 连接复位按键、47 kΩ 上拉和 10 nF 电容；正常下载、调试和可靠复位建议保持启用，关闭只释放当前规划安排。",
          "pins": { "38": "RESET" },
          "assignments": { "38": "NRST" }
        }
      ],
      "sharedBuses": [
        {
          "id": "SPI1",
          "name": "SPI1 共享总线",
          "resources": ["spi-flash", "h8-lcd"],
          "pins": ["60", "61"],
          "summary": "Flash 与 LCD/OLED 共用 PB8 数据线和 PB9 时钟线",
          "detail": "这不是引脚冲突：PB8 同时连接 Flash MOSI 与 LCD SDA，PB9 同时连接 Flash CLK 与 LCD SCL；两者使用独立片选即可挂在同一 SPI1 总线上。",
          "chipSelectPins": {
            "spi-flash": "PB6 / Pin 58 / W_CS",
            "h8-lcd": "PB14 / Pin 2 / LCD_CS"
          }
        }
      ]
    }
